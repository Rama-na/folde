{
  "name": "snug",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "test:shrink": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-shrink.ts",
    "test:bytes": "tsx scripts/test-bytes.ts",
