{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ReadyPDF has no server. There is no `main` here on purpose: with only `assets`,
  // Wrangler deploys the exported directory as static files and runs no code.
  //
  // This file also exists to STOP Wrangler configuring the project for us. With no
  // config present it detects "Next.js", assumes a server-rendered app, installs
  // the OpenNext adapter and rebuilds looking for `.next/standalone` - which a
  // static export never produces, so the deploy dies on a missing
  // pages-manifest.json after a build that succeeded.
  // The Worker this deploys to, which is NOT the product name — that lives in
  // `lib/brand.ts` and is free to change without touching anything here.
  //
  // It has to match the Cloudflare project, because `wrangler deploy` reads the
  // name from this file and deploys to whatever it says. While it said "readypdf"
  // and the project was "folde", a successful build would have published to a
  // different Worker and left folde.ramana-jp.workers.dev serving the old one.
  // Renaming the Cloudflare project to readypdf and changing this line back is the
  // other way round, and costs the existing URL.
  "name": "folde",
  "compatibility_date": "2026-09-11",

  "assets": {
    "directory": "./out",
    // `next build` with `trailingSlash` emits 404/index.html; serve it for unknown
    // paths rather than Cloudflare's default plain-text 404.
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
