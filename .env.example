# Snug runs entirely in the browser for now, so there is very little to set.
# That is deliberate: every variable added here is a document that leaves
# someone's device. Copy this file to .env for local development.

# Public URL of the app, WITH scheme (https://...). On Railway you can omit
# this entirely — RAILWAY_PUBLIC_DOMAIN is picked up automatically. It is used
# for absolute URLs in share links and metadata; if it is wrong, links render
# pointing at localhost and silently break for everyone but you.
APP_URL=http://localhost:3000

# --- Not needed until Slice 4 (sending via Snug) ---------------------------
# Left here as a map of what is coming, not as values to fill in now. Adding
# any of these turns on a path that uploads document contents to a server, so
# each one must arrive together with the UI that tells the user it is happening.
#
#   RESEND_API_KEY        sending batches as email
#   EMAIL_FROM            verified sender domain; unverified = silent bounces
#   DATABASE_URL          Railway Postgres, for send jobs + delivery receipts
#   R2_*                  Cloudflare R2, for share links
